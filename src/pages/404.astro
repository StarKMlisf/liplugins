---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/paths';
---

<BaseLayout title="页面不存在" noIndex>
  <section class="section shell" style="min-height:65svh; display:grid; place-items:center; text-align:center;">
    <div><span class="eyebrow">404 / Lost season</span><h1 class="display-title" style="margin:.8rem 0 1.3rem;">这一页还没<br />进入季节。</h1><p style="color:var(--ink-soft);">链接可能已经调整，或者页面尚未公开。</p><a class="button button--primary" href={withBase('/')} style="margin-top:1rem;">返回首页</a></div>
  </section>
</BaseLayout>

