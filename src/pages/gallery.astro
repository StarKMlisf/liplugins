---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeatureGallery from '@/components/FeatureGallery.astro';
import { featureGalleries } from '@/data/feature-gallery';
---
<BaseLayout title="功能实拍" description="Li 系列插件的实际游戏界面：换肤、称号、附魔、传送石碑与抽签。">
  <header class="section shell">
    <span class="eyebrow">LAOLI PLUGINS / IN GAME</span>
    <h1>在游戏里，它们是什么样？</h1>
    <p>从实际菜单到玩法效果，浏览已收录的 {featureGalleries.length} 款插件、{featureGalleries.reduce((sum, entry) => sum + entry.shots.length, 0)} 张游戏实拍。</p>
    <nav class="button-row" aria-label="选择插件">
      {featureGalleries.map(entry => <a class="button" href={`#gallery-${entry.slug}`}>{entry.name}</a>)}
    </nav>
  </header>
  {featureGalleries.map(entry => <FeatureGallery slug={entry.slug} />)}
</BaseLayout>
