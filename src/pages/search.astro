---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildSearchIndex } from '@/lib/wiki';

const searchIndex = buildSearchIndex();
---

<BaseLayout title="搜索" description="搜索牢李插件系列全部中文文档。">
  <header class="page-heading">
    <div class="page-heading__grid shell">
      <div><span class="eyebrow">Search / 搜索</span><h1>找到你需要的<br />那一节。</h1></div>
      <p>搜索三款插件的标题、摘要和正文。可尝试“26.2”“称号卷轴”“附魔冲突”“TAB 异步”等关键词。</p>
    </div>
  </header>
  <section class="section shell">
    <div class="search-panel">
      <div class="search-box"><input type="search" placeholder="输入关键词…" autocomplete="off" data-search-input /><span>⌘ / Ctrl + K</span></div>
      <div class="search-summary" data-search-summary>输入关键词开始搜索 {searchIndex.length} 篇文档</div>
      <div class="search-results" data-search-results></div>
    </div>
  </section>
  <script is:inline type="application/json" id="wiki-search-index" set:html={JSON.stringify(searchIndex)} />
</BaseLayout>

<script>
  import { withBase } from '@/lib/paths';

  interface SearchEntry { title: string; summary: string; slug: string; group: string; project: string; projectName: string; content: string; }
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const results = document.querySelector<HTMLElement>('[data-search-results]');
  const summary = document.querySelector<HTMLElement>('[data-search-summary]');
  const indexNode = document.querySelector<HTMLScriptElement>('#wiki-search-index');
  const entries: SearchEntry[] = JSON.parse(indexNode?.textContent || '[]');

  const escapeHtml = (value: string) => value.replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#039;', '"': '&quot;' })[character] || character);

  function render(query: string) {
    if (!results || !summary) return;
    const terms = query.trim().toLowerCase().split(/\s+/).filter(Boolean);
    if (!terms.length) {
      results.innerHTML = '';
      summary.textContent = `输入关键词开始搜索 ${entries.length} 篇文档`;
      return;
    }
    const matches = entries.filter((entry) => {
      const haystack = `${entry.projectName} ${entry.title} ${entry.summary} ${entry.content}`.toLowerCase();
      return terms.every((term) => haystack.includes(term));
    });
    summary.textContent = `找到 ${matches.length} 篇相关文档`;
    results.innerHTML = matches.length ? matches.map((entry) => `
      <a class="search-result" href="${withBase(`/docs/${entry.project}/${entry.slug}/`)}">
        <span>${escapeHtml(entry.projectName)} · ${escapeHtml(entry.group)}</span><h2>${escapeHtml(entry.title)}</h2><p>${escapeHtml(entry.summary)}</p>
      </a>`).join('') : '<div class="empty-state">没有找到匹配内容，试试更短或不同的关键词。</div>';
  }

  input?.addEventListener('input', () => render(input.value));
  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault(); input?.focus();
    }
  });
  const initialQuery = new URLSearchParams(location.search).get('q');
  if (initialQuery && input) { input.value = initialQuery; render(initialQuery); }
</script>
