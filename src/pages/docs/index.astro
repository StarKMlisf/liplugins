---
import BaseLayout from '@/layouts/BaseLayout.astro';
import VoxelBlock from '@/components/VoxelBlock.astro';
import { docSets, allDocs } from '@/data/docs';
import { catalogSections } from '@/data/site';
import { withBase } from '@/lib/paths';

const docSetBySlug = new Map(docSets.map((docSet) => [docSet.slug, docSet]));
---

<BaseLayout title="文档" description="牢李插件系列的安装、配置、玩法、运维与开发文档目录。">
  <header class="page-heading">
    <div class="page-heading__grid shell">
      <div><span class="eyebrow">Documentation / 文档</span><h1>从第一次安装，<br />到长期运行。</h1></div>
      <p>文档按作品组织。每一组都覆盖开始使用、玩法机制、配置参考、兼容范围和故障排查。</p>
    </div>
  </header>
  <section class="section shell">
    <div class="section-heading">
      <span class="eyebrow">Document sets / 文档集</span>
      <div><h2>十一款插件，<br />全部建立文档入口。</h2><p>当前共 {allDocs.length} 篇主题页面；目录按销售状态、编号和功能标签组织，进入插件后再按总览、玩家、管理员与开发者分区阅读。</p></div>
    </div>
    {catalogSections.map((section) => (
      <section class="catalog-section" id={section.id}>
        <div class="catalog-section__heading catalog-section__heading--compact">
          <div><span class="eyebrow">{section.number}. Documentation group</span><h2>{section.number}. {section.title}</h2></div>
          <p>{section.description}</p>
        </div>
        <div class="directory-grid">
          {section.works.map((work, index) => {
            const docSet = docSetBySlug.get(work.slug);
            return docSet && (
              <a class="directory-card" href={withBase(`/docs/${docSet.slug}/`)}>
                <span class="directory-card__group"><VoxelBlock type={docSet.icon} size="small" />{section.number}-{index + 1}. [{work.catalogLabel}] / {docSet.version}</span><span class="directory-card__arrow">↗</span>
                <h2>{docSet.name}</h2><p>{docSet.summary}</p>
                <div class="work-feature__meta" style="margin-top:1.2rem;"><span class="tag">{docSet.docs.length} 篇页面</span></div>
              </a>
            );
          })}
        </div>
      </section>
    ))}
    <div class="button-row" style="margin-top:2rem;"><a class="button" href={withBase('/search/')}>搜索全部文档</a></div>
  </section>
</BaseLayout>
