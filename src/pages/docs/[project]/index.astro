---
import BaseLayout from '@/layouts/BaseLayout.astro';
import VoxelBlock from '@/components/VoxelBlock.astro';
import { docSets, type DocSet } from '@/data/docs';
import { withBase } from '@/lib/paths';

export function getStaticPaths() {
  return docSets.map((docSet) => ({ params: { project: docSet.slug }, props: { docSet } }));
}

const { docSet } = Astro.props as { docSet: DocSet };
const groupIcons = {
  '文档总览': 'book',
  '玩家文档': 'grass',
  '管理员文档': 'redstone',
  '开发者文档': 'ice',
  '附魔详情': 'amethyst',
} as const;
const visibleDocs = docSet.docs.filter((doc) => doc.sidebar !== false);
const hiddenDocs = docSet.docs.filter((doc) => doc.sidebar === false);
---

<BaseLayout title={`${docSet.name} 文档`} description={`${docSet.name} ${docSet.version} 完整中文使用文档。`}>
  <header class="page-heading">
    <div class="page-heading__grid shell">
      <div><span class="eyebrow">{docSet.name} {docSet.version} / Documentation</span><h1>完整中文<br />使用文档。</h1></div>
      <div>
        <p>{docSet.summary} 当前收录 {docSet.docs.length} 篇页面。</p>
        <div class="button-row" style="margin-top:1.5rem;"><a class="button button--primary" href={withBase(`/docs/${docSet.slug}/home/`)}>从首页开始</a><a class="button" href={withBase(`/search/?q=${encodeURIComponent(docSet.name)}`)}>搜索</a></div>
      </div>
    </div>
  </header>
  <section class="section shell">
    {docSet.groups.map((group) => (
      <section style="margin-bottom: 4.5rem;">
        <div class="section-heading" style="margin-bottom: 1.5rem;">
          <span class="eyebrow" style="display:flex; gap:.6rem; align-items:center;"><VoxelBlock type={groupIcons[group]} size="small" />{String(docSet.groups.indexOf(group) + 1).padStart(2, '0')}</span>
          <h2 style="font-size:clamp(2rem,4vw,3.2rem);">{group}</h2>
        </div>
        <div class="directory-grid">
          {visibleDocs.filter((doc) => doc.group === group).map((doc) => (
            <a class="directory-card" href={withBase(`/docs/${docSet.slug}/${doc.slug}/`)}>
              <span class="directory-card__group"><VoxelBlock type={groupIcons[group]} size="small" />{group}</span><span class="directory-card__arrow">↗</span>
              <h2>{doc.title}</h2><p>{doc.summary}</p>
            </a>
          ))}
        </div>
      </section>
    ))}
    {hiddenDocs.length > 0 && (
      <section class="work-feature" style="grid-template-columns:minmax(0,1fr) minmax(260px,.45fr);">
        <div class="work-feature__story">
          <span class="eyebrow">Enchantment reference / 附魔详情</span>
          <h3 style="font-size:clamp(2.4rem,5vw,4.6rem);">{hiddenDocs.length} 篇<br />逐项机制说明</h3>
          <p>每个附魔都有独立页面，包含适用装备、最高等级、实际触发、每级数值、冷却、粒子与声音。请从“附魔图鉴”按中文名称进入。</p>
          <a class="button button--primary" href={withBase(`/docs/${docSet.slug}/enchantments/`)}>打开完整附魔图鉴</a>
        </div>
        <div class="work-feature__visual" style="min-height:330px;"><VoxelBlock type="amethyst" size="large" label="紫水晶附魔图鉴" /></div>
      </section>
    )}
  </section>
</BaseLayout>
