---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MinecraftServerStage from '@/components/MinecraftServerStage.astro';
import VoxelBlock from '@/components/VoxelBlock.astro';
import { works } from '@/data/site';
import { allDocs } from '@/data/docs';
import { withBase } from '@/lib/paths';

const paidWorks = works.filter((work) => work.availability === '付费');
const freeWorks = works.filter((work) => work.availability === '免费');
const workBySlug = new Map(works.map((work) => [work.slug, work]));
const featuredWorks = ['liemc', 'lirealenchant', 'liseasons', 'lipet']
  .map((slug) => workBySlug.get(slug))
  .filter((work) => Boolean(work));

const voxelTypes = ['grass', 'gold', 'amethyst', 'redstone', 'meteor', 'book', 'leaf', 'ice'] as const;
const workVoxel: Record<string, (typeof voxelTypes)[number]> = {
  liseasons: 'grass',
  lititle: 'gold',
  lirealenchant: 'amethyst',
  liemc: 'redstone',
  enderdragon: 'meteor',
  lishop: 'gold',
  lianimalscale: 'leaf',
  lipet: 'redstone',
  lichqian: 'gold',
  liskin: 'ice',
  jisseechessgames: 'book',
};

const shortcutSlugs = ['liseasons', 'liemc', 'lirealenchant', 'lipet', 'lititle', 'enderdragon'];
const shortcutWorks = shortcutSlugs.map((slug) => workBySlug.get(slug)).filter((work) => Boolean(work));
const availabilityLabel = (work: (typeof works)[number]) =>
  work.availability === '付费' ? `¥${work.priceCny}` : work.availability;
---

<BaseLayout>
  <section class="home-hero">
    <div class="home-hero__pixels" aria-hidden="true"></div>
    <div class="home-hero__inner shell">
      <div class="home-hero__copy">
        <span class="server-badge"><i></i> SERVER PLUGINS · PAPER 26.1.2</span>
        <h1>给服务器世界<br /><em>加点真玩法。</em></h1>
        <p>从 EMC 经济、真实附魔到四季气候与宠物养成，牢李插件把一个想法做成玩家能感受到、服主能长期维护的完整系统。</p>
        <div class="button-row">
          <a class="button button--primary" href={withBase('/works/')}>进入插件大厅 <span>→</span></a>
          <a class="button" href={withBase('/docs/')}>打开中文 Wiki</a>
        </div>
        <dl class="home-stats" aria-label="网站数据">
          <div><dt>{works.length}</dt><dd>款插件</dd></div>
          <div><dt>{allDocs.length}</dt><dd>篇文档</dd></div>
          <div><dt>26.1.2</dt><dd>基准支持</dd></div>
        </dl>
      </div>

      <MinecraftServerStage />
    </div>
  </section>

  <nav class="home-shortcuts" aria-label="热门插件快捷入口">
    <div class="home-hotbar shell">
      {shortcutWorks.map((work, index) => work && (
        <a class="home-hotbar__slot" href={withBase(`/works/${work.slug}/`)}>
          <kbd>{index + 1}</kbd>
          <VoxelBlock type={workVoxel[work.slug] ?? 'grass'} size="medium" />
          <span><strong>{work.name}</strong><small>{work.catalogLabel}</small></span>
        </a>
      ))}
    </div>
  </nav>

  <section class="home-section home-section--gameplay shell">
    <div class="home-section__heading">
      <div><span class="pixel-kicker">01 / GAMEPLAY MODULES</span><h2>不是工具箱，<br />是能玩的世界模组。</h2></div>
      <p>四个代表性系统，分别改变服务器里的资源循环、装备构筑、自然环境与伙伴关系。</p>
    </div>

    <div class="gameplay-grid">
      {featuredWorks.map((work, index) => work && (
        <article class:list={['gameplay-card', `gameplay-card--${index + 1}`]}>
          <div class="gameplay-card__top">
            <span class="gameplay-card__icon"><VoxelBlock type={workVoxel[work.slug] ?? 'grass'} size="large" /></span>
            <span class="pixel-tag">{availabilityLabel(work)}</span>
          </div>
          <span class="gameplay-card__category">{work.catalogLabel} / {String(index + 1).padStart(2, '0')}</span>
          <h3>{work.name}</h3>
          <p>{work.summary}</p>
          <a href={withBase(`/works/${work.slug}/`)} aria-label={`查看 ${work.name}`}>查看玩法 <span>↗</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="home-section home-section--inventory">
    <div class="shell">
      <div class="home-section__heading">
        <div><span class="pixel-kicker">02 / PLUGIN INVENTORY</span><h2>插件背包，<br />共 {works.length} 个栏位。</h2></div>
        <div class="inventory-summary"><span>{paidWorks.length} 款付费</span><span>{freeWorks.length} 款免费</span><span>1 款开发中</span></div>
      </div>

      <div class="plugin-grid">
        {works.map((work, index) => (
          <article class:list={['plugin-card', `plugin-card--${work.availability === '免费' ? 'free' : work.availability === '付费' ? 'paid' : 'dev'}`]}>
            <div class="plugin-card__top">
              <span class="plugin-card__number">SLOT {String(index + 1).padStart(2, '0')}</span>
              <span class="plugin-card__availability">{availabilityLabel(work)}</span>
            </div>
            <div class="plugin-card__identity">
              <span class="plugin-card__block"><VoxelBlock type={workVoxel[work.slug] ?? 'grass'} size="medium" /></span>
              <div><small>{work.catalogLabel}</small><h3><a href={withBase(`/works/${work.slug}/`)}>{work.name}</a></h3></div>
            </div>
            <p>{work.summary}</p>
            <div class="plugin-card__footer">
              <span>v{work.version}</span>
              <span class="plugin-card__links">
                <a href={withBase(`/works/${work.slug}/`)}>介绍</a>
                <a href={withBase(`/docs/${work.slug}/`)}>Wiki</a>
              </span>
            </div>
          </article>
        ))}
      </div>

      <div class="home-section__more">
        <a class="button" href={withBase('/works/')}>按付费 / 免费分类查看全部作品 <span>→</span></a>
      </div>
    </div>
  </section>

  <section class="home-section shell">
    <div class="docs-console">
      <div class="docs-console__copy">
        <span class="pixel-kicker">03 / COMPLETE WIKI</span>
        <h2>每个插件，<br />都配一整套说明书。</h2>
        <p>不是只写几条指令。安装、权限、配置、玩法、管理、排错与开发接口，都能从目录继续查下去。</p>
        <div class="button-row">
          <a class="button button--primary" href={withBase('/docs/')}>进入 {allDocs.length} 篇中文文档</a>
          <a class="button" href={withBase('/support/')}>查看支持方式</a>
        </div>
      </div>
      <div class="docs-console__screen" aria-label="文档检索状态">
        <div><span>LAOLI_WIKI</span><span>● ONLINE</span></div>
        <pre><code>&gt; /wiki index --all

[OK]  插件目录 ........ {works.length}/{works.length}
[OK]  中文页面 ........ {allDocs.length}
[OK]  安装与配置 ...... READY
[OK]  指令与权限 ...... READY
[OK]  故障排查 ........ READY

输入插件名即可开始查询_</code></pre>
      </div>
    </div>
  </section>

  <section class="home-section home-section--quality">
    <div class="shell">
      <div class="home-section__heading">
        <div><span class="pixel-kicker">04 / SERVER RULES</span><h2>上线能玩，<br />更新也能放心。</h2></div>
      </div>
      <div class="quality-grid">
        <article><span>01</span><h3>玩家有反馈</h3><p>每个系统都要变成看得见、听得到、能参与的游戏体验。</p></article>
        <article><span>02</span><h3>服主能判断</h3><p>依赖、兼容范围、配置说明与故障路径尽量写清楚。</p></article>
        <article><span>03</span><h3>升级不拆家</h3><p>新增配置自动补齐，并尽可能保留已经调整好的长期设定。</p></article>
      </div>
    </div>
  </section>
</BaseLayout>
