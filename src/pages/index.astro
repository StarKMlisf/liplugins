---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { works } from '@/data/site';
import { allDocs } from '@/data/docs';
import { withBase } from '@/lib/paths';

const paidWorks = works.filter((work) => work.availability === '付费');
const freeWorks = works.filter((work) => work.availability === '免费');
const workBySlug = new Map(works.map((work) => [work.slug, work]));
const featuredWorks = [
  {
    work: workBySlug.get('liemc')!,
    image: '/images/featured-liemc.webp',
    imageAlt: '夕阳中的 EMC 炼成工坊与发光资源方块',
    tone: 'ember',
  },
  {
    work: workBySlug.get('lirealenchant')!,
    image: '/images/featured-lirealenchant.webp',
    imageAlt: '蓝紫色夜色中的真实附魔图书馆与锻造工坊',
    tone: 'arcane',
  },
  {
    work: workBySlug.get('liseasons')!,
    image: '/images/featured-liseasons.webp',
    imageAlt: '由春夏过渡到秋冬的同一座山谷与河流',
    tone: 'season',
  },
];

const availabilityLabel = (work: (typeof works)[number]) =>
  work.availability === '付费'
    ? work.originalPriceCny
      ? `优惠 ¥${work.priceCny} / 原价 ¥${work.originalPriceCny}`
      : `¥${work.priceCny}`
    : work.availability;
---

<BaseLayout bodyClass="home-page">
  <section class="home-hero" aria-labelledby="home-title">
    <img
      class="home-hero__image"
      src={withBase('/images/home-world-hero.webp')}
      alt=""
      width="1672"
      height="941"
      fetchpriority="high"
      decoding="async"
    />
    <div class="home-hero__veil" aria-hidden="true"></div>
    <div class="home-hero__content shell">
      <div class="home-hero__copy">
        <span class="home-overline">LAOLI PLUGINS · PAPER 26.1.2</span>
        <h1 id="home-title">牢李插件系列</h1>
        <p class="home-hero__tagline">把玩法，写进世界。</p>
        <p class="home-hero__lead">
          为 Minecraft 服务器制作完整、可靠、能够长期维护的玩法插件。
          从资源经济与真实附魔，到四季气候、宠物养成和跨服体验。
        </p>
        <div class="home-hero__actions">
          <a class="home-hero__button home-hero__button--primary" href="#featured">浏览精选作品 <span>↓</span></a>
          <a class="home-hero__button" href={withBase('/docs/')}>查看中文文档 <span>↗</span></a>
        </div>
        <dl class="home-hero__facts" aria-label="网站数据">
          <div><dt>{works.length}</dt><dd>款插件</dd></div>
          <div><dt>{allDocs.length}</dt><dd>篇文档</dd></div>
          <div><dt>26.1.2</dt><dd>基准支持</dd></div>
        </dl>
      </div>
    </div>
    <a class="home-hero__scroll" href="#featured"><span>SCROLL TO EXPLORE</span><i aria-hidden="true"></i></a>
  </section>

  <section class="home-featured" id="featured">
    <div class="shell">
      <header class="home-section-heading">
        <div>
          <span class="home-overline">01 · SELECTED WORKS</span>
          <h2>精选作品</h2>
        </div>
        <div class="home-section-heading__aside">
          <p>三个不同方向的代表项目：资源循环、装备构筑与自然世界。每一款都有独立玩法和完整中文文档。</p>
          <a href={withBase('/works/')}>查看全部作品 <span>↗</span></a>
        </div>
      </header>

      <div class="featured-work-list">
        {featuredWorks.map(({ work, image, imageAlt, tone }, index) => (
          <article class:list={['featured-work', `featured-work--${tone}`]}>
            <a class="featured-work__visual" href={withBase(`/works/${work.slug}/`)} aria-label={`查看 ${work.name}`}>
              <img src={withBase(image)} alt={imageAlt} width="1600" height="1000" loading="lazy" decoding="async" />
              <span class="featured-work__index">{String(index + 1).padStart(2, '0')}</span>
              <span class="featured-work__price">{availabilityLabel(work)}</span>
            </a>
            <div class="featured-work__copy">
              <span>{work.catalogLabel} · {work.status}</span>
              <h3>
                <a href={withBase(`/works/${work.slug}/`)}>
                  {work.slug === 'lirealenchant' ? <>LiReal<wbr />Enchant2</> : work.name}
                </a>
              </h3>
              <p>{work.summary}</p>
              <div class="featured-work__links">
                <a href={withBase(`/works/${work.slug}/`)}>功能介绍 <span>→</span></a>
                <a href={withBase(`/docs/${work.slug}/`)}>完整 Wiki <span>→</span></a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="home-catalog">
    <div class="shell">
      <header class="home-section-heading home-section-heading--compact">
        <div>
          <span class="home-overline">02 · ALL PLUGINS</span>
          <h2>全部插件</h2>
        </div>
        <div class="home-catalog__summary" aria-label="插件销售状态">
          <span>{paidWorks.length} 款付费</span>
          <span>{freeWorks.length} 款免费</span>
          <span>{works.length - paidWorks.length - freeWorks.length} 款开发中</span>
        </div>
      </header>

      <div class="home-catalog__list">
        {works.map((work, index) => (
          <a class="home-catalog__item" href={withBase(`/works/${work.slug}/`)}>
            <span class="home-catalog__number">{String(index + 1).padStart(2, '0')}</span>
            <div class="home-catalog__identity">
              <small>{work.catalogLabel}</small>
              <h3>{work.name}</h3>
              <p>{work.kicker}</p>
            </div>
            <span class:list={['home-catalog__availability', work.availability === '免费' && 'is-free', work.availability === '暂不发售' && 'is-dev']}>
              {availabilityLabel(work)}
            </span>
            <span class="home-catalog__arrow">↗</span>
          </a>
        ))}
      </div>

      <div class="home-catalog__more">
        <a class="text-link" href={withBase('/works/')}>按付费、免费与开发状态浏览作品目录</a>
      </div>
    </div>
  </section>

  <section class="home-wiki">
    <div class="home-wiki__inner shell">
      <div class="home-wiki__copy">
        <span class="home-overline">03 · COMPLETE WIKI</span>
        <h2>不只给插件，<br />也把使用方法讲清楚。</h2>
        <p>
          安装、依赖、权限、指令、配置、玩法、管理与故障排查，
          每款插件都配有可以继续向下查阅的完整中文文档。
        </p>
        <a class="home-wiki__primary" href={withBase('/docs/')}>打开 {allDocs.length} 篇中文文档 <span>↗</span></a>
      </div>
      <div class="home-wiki__links">
        <a href={withBase('/docs/')}>
          <span>01</span>
          <div><strong>文档中心</strong><p>按插件查看安装、配置、指令与完整玩法说明。</p></div>
          <i>↗</i>
        </a>
        <a href={withBase('/support/')}>
          <span>02</span>
          <div><strong>支持与购买</strong><p>查看购买说明、提问前准备与问题反馈方式。</p></div>
          <i>↗</i>
        </a>
        <a href={withBase('/about/')}>
          <span>03</span>
          <div><strong>关于项目</strong><p>了解牢李插件的维护原则、兼容范围与项目边界。</p></div>
          <i>↗</i>
        </a>
      </div>
    </div>
  </section>

  <section class="home-belief">
    <div class="shell">
      <span class="home-overline">04 · BUILT FOR LONG-TERM WORLDS</span>
      <p class="home-belief__statement">
        好插件不该只是“能启动”。它要让玩家感受到玩法，让服主看得懂配置，
        也让一次更新不必拆掉已经经营很久的世界。
      </p>
      <div class="home-belief__principles">
        <article><span>01</span><h2>玩家有反馈</h2><p>系统变化应该看得见、听得到，也能真正参与。</p></article>
        <article><span>02</span><h2>服主能判断</h2><p>兼容范围、配置含义和排错路径都尽量说清楚。</p></article>
        <article><span>03</span><h2>升级不拆家</h2><p>新增配置自动补齐，并尽可能保留已有长期设定。</p></article>
      </div>
    </div>
  </section>
</BaseLayout>
