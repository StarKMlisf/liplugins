---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { works, type WorkEntry } from '@/data/site';
import { withBase } from '@/lib/paths';

export function getStaticPaths() {
  const bespokePages = new Set(['liseasons', 'lititle', 'lirealenchant']);
  return works
    .filter((work) => !bespokePages.has(work.slug))
    .map((work) => ({ params: { slug: work.slug }, props: { work } }));
}

interface Props {
  work: WorkEntry;
}

const { work } = Astro.props;
const workNumber = works.findIndex((entry) => entry.slug === work.slug) + 1;
const availabilityLabel =
  work.availability === '付费' ? `付费插件 · ¥${work.priceCny}` : work.availability;
const availabilityClass =
  work.availability === '付费'
    ? 'tag--paid'
    : work.availability === '免费'
      ? 'tag--free'
      : 'tag--unavailable';
---

<BaseLayout title={work.name} description={work.summary}>
  <header class="work-hero">
    <div class="shell">
      <div class="work-hero__top">
        <div>
          <div class="work-hero__labels">
            <span class="eyebrow">Work {String(workNumber).padStart(2, '0')} / Plugin profile</span>
            <span class:list={['tag', availabilityClass]}>{availabilityLabel}</span>
          </div>
          <h1>{work.name}</h1>
          <p class="work-hero__lead">{work.summary}</p>
        </div>
        <div class:list={['work-emblem', 'work-emblem--catalog', work.availability === '付费' && 'work-emblem--gold']} aria-label={`${work.name}，${availabilityLabel}`}>
          <span class="work-emblem__code">LAOLI PLUGINS</span>
          <strong>{work.name}</strong>
          <span class="work-emblem__price">{work.availability === '付费' ? `¥${work.priceCny}` : work.availability}</span>
        </div>
      </div>
      <div class="work-facts">
        <div class="work-fact"><span>Version</span><strong>{work.version}</strong></div>
        <div class="work-fact"><span>Status</span><strong>{work.status}</strong></div>
        <div class="work-fact"><span>Platform</span><strong>{work.platform}</strong></div>
        <div class="work-fact"><span>Minecraft</span><strong>{work.minecraft}</strong></div>
        <div class="work-fact"><span>Runtime</span><strong>{work.java}</strong></div>
      </div>
    </div>
  </header>

  <section class="section shell">
    <div class="section-heading">
      <span class="eyebrow">Overview / 插件介绍</span>
      <div>
        <h2>{work.kicker}</h2>
        <p>{work.description}</p>
      </div>
    </div>

    <div class="feature-chapter">
      <div><span class="feature-chapter__number">01 / FEATURES</span><h2>核心功能</h2></div>
      <div class="feature-chapter__body">
        <div class="feature-list">
          {work.features.map((feature) => (
            <div><strong>{feature}</strong></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--bordered">
    <div class="shell">
      <div class="section-heading">
        <span class="eyebrow">Environment / 运行环境</span>
        <div><h2>安装前先确认版本与前置。</h2><p>兼容范围以当前作品说明为准，正式服更新前建议先在测试环境验证配置和数据。</p></div>
      </div>
      <div class="directory-grid">
        <div class="directory-card"><span class="directory-card__group">支持核心</span><h2>{work.platform}</h2><p>Minecraft {work.minecraft}</p></div>
        <div class="directory-card"><span class="directory-card__group">运行环境</span><h2>{work.java}</h2><p>服务端 Java 版本还需满足对应 Paper 或 Folia 核心要求。</p></div>
        <div class="directory-card"><span class="directory-card__group">发布状态</span><h2>{availabilityLabel}</h2><p>{work.availability === '暂不发售' ? '当前版本仍在完善，不提供购买。' : '具体授权、交付与支持方式以获取时说明为准。'}</p></div>
        <div class="directory-card"><span class="directory-card__group">依赖与联动</span><h2>{work.dependencies.length} 项说明</h2><p>{work.dependencies.join(' · ')}</p></div>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="cta-band__inner shell">
      <h2>{work.availability === '暂不发售' ? '关注后续更新，\n等待正式开放。' : '先了解功能，\n再决定是否适合服务器。'}</h2>
      <div class="button-row">
        <a class="button button--primary" href={withBase('/works/')}>返回作品目录</a>
        <a class="button" href={withBase('/support/')}>查看获取与支持说明</a>
      </div>
    </div>
  </section>
</BaseLayout>
