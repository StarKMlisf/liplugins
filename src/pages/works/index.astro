---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { catalogSections, works } from '@/data/site';
import { withBase } from '@/lib/paths';
const availabilityLabel = (work: (typeof works)[number]) =>
  work.availability === '付费' ? `付费插件 · ¥${work.priceCny}` : work.availability;
const availabilityClass = (work: (typeof works)[number]) =>
  work.availability === '付费'
    ? 'tag--paid'
    : work.availability === '免费'
      ? 'tag--free'
      : 'tag--unavailable';
---

<BaseLayout title="作品" description="浏览牢李插件系列当前发布和持续维护的 Minecraft 服务器插件。" bodyClass="works-page">
  <header class="page-heading">
    <div class="page-heading__grid shell">
      <div><span class="eyebrow">Works / 作品</span><h1>为真实服务器<br />解决真实问题。</h1></div>
      <p>作品目录会说明每款插件解决什么问题、适用什么环境，以及免费或付费状态。付费插件直接展示当前标价，不隐藏在咨询流程里。</p>
    </div>
  </header>
  <section class="section shell">
    {catalogSections.map((section) => (
      <section class="catalog-section" id={section.id}>
        <div class="catalog-section__heading">
          <div><span class="eyebrow">{section.number}. Catalog group</span><h2>{section.number}. {section.title}</h2></div>
          <p>{section.description}</p>
          <span class="catalog-section__count">{section.works.length} 款</span>
        </div>
        <div class="works-list">
          {section.works.map((work, index) => (
            <article class="work-row">
              <span class="work-row__number">{section.number}-{index + 1}</span>
              <h2><a href={withBase(`/works/${work.slug}/`)}>[{work.catalogLabel}] {work.name}</a><span>{work.kicker}</span></h2>
              <div class="work-row__summary">
                <p>{work.summary}</p>
                <div class="work-row__meta">
                  <span class="tag">v{work.version}</span>
                  <span class:list={['tag', availabilityClass(work)]}>{availabilityLabel(work)}</span>
                </div>
              </div>
              <div class="work-row__actions"><a href={withBase(`/works/${work.slug}/`)}>介绍 ↗</a><a href={withBase(`/docs/${work.slug}/`)}>文档 ↗</a></div>
            </article>
          ))}
        </div>
      </section>
    ))}
    <p style="margin: 2rem 0 0; color: var(--ink-soft); font-size: .8rem;">当前收录 {works.length} 款插件。免费、付费与暂不发售状态均按当前公开信息展示；付费插件的授权范围、交付方式和售后渠道以购买时说明为准。</p>
  </section>
</BaseLayout>
