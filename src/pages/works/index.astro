---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { catalogSections, works } from '@/data/site';
import { withBase } from '@/lib/paths';

const availabilityLabel = (work: (typeof works)[number]) =>
  work.availability === '付费'
    ? work.originalPriceCny
      ? `付费 · ¥${work.priceCny}（原价 ¥${work.originalPriceCny}）`
      : `付费 · ¥${work.priceCny}`
    : work.kind === '教程'
      ? '免费教程'
      : work.availability;
---

<BaseLayout title="作品" description="浏览牢李插件系列当前发布和持续维护的 Minecraft 服务器插件、工具与中文教程。" bodyClass="editorial-works">
  <header class="directory-intro shell">
    <span class="editorial-kicker">项目目录</span>
    <h1>作品</h1>
    <p>服务器玩法插件、管理工具与配套内容。每个项目都标明当前版本、运行平台、公开状态和中文文档。</p>

    <nav class="directory-tabs" aria-label="作品分类">
      <a href="#catalog">全部 <span>{works.length}</span></a>
      {catalogSections.map((section) => <a href={`#${section.id}`}>{section.title} <span>{section.works.length}</span></a>)}
    </nav>
  </header>

  <div class="directory shell" id="catalog">
    {catalogSections.map((section) => (
      <section class="directory-section" id={section.id}>
        <header class="directory-section__heading">
          <h2>{section.title}</h2>
          <p>{section.description}</p>
          <span>{section.works.length} 项</span>
        </header>

        <div class="directory-grid">
          {section.works.map((work, index) => (
            <article class="directory-work">
              <a
                class:list={['directory-work__visual', !work.artwork && `directory-work__visual--tone-${index % 4}`]}
                href={withBase(`/works/${work.slug}/`)}
                aria-label={`查看 ${work.name}`}
              >
                {work.artwork ? (
                  <img src={withBase(work.artwork.src)} alt={work.artwork.alt} width="1600" height="1000" loading="lazy" decoding="async" />
                ) : (
                  <span><small>{work.catalogLabel}</small><strong>{work.name}</strong></span>
                )}
              </a>

              <div class="directory-work__body">
                <p class="directory-work__meta">{work.catalogLabel} · {availabilityLabel(work)} · {work.status}</p>
                <h3><a href={withBase(`/works/${work.slug}/`)}>{work.name}</a></h3>
                <p>{work.summary}</p>
                <dl>
                  <div><dt>版本</dt><dd>{work.version}</dd></div>
                  <div><dt>平台</dt><dd>{work.platform}</dd></div>
                </dl>
                <div class="directory-work__links">
                  <a href={withBase(`/works/${work.slug}/`)}>功能介绍</a>
                  <a href={withBase(`/docs/${work.slug}/home/`)}>使用文档</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}

    <p class="directory-note">当前收录 {works.length} 个项目。付费插件的价格、交付方式和售后范围以购买时的公开说明为准。</p>
  </div>
</BaseLayout>
