---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SeasonMark from '@/components/SeasonMark.astro';
import VoxelBlock from '@/components/VoxelBlock.astro';
import { works } from '@/data/site';
import { withBase } from '@/lib/paths';

const work = works[0];
---

<BaseLayout title="LISeasons" description={work.summary}>
  <header class="work-hero">
    <div class="shell">
      <div class="work-hero__top">
        <div>
          <span class="eyebrow">Work 01 / Seasons & climate</span>
          <h1>LISeasons</h1>
          <p class="work-hero__lead">{work.summary}</p>
          <div class="button-row" style="margin-top: 2rem;">
            <a class="button button--primary" href={withBase('/docs/liseasons/home/')}>开始阅读文档</a>
            <a class="button" href="https://github.com/StarKMlisf/LiSeasons" target="_blank" rel="noreferrer">查看 GitHub <span>↗</span></a>
          </div>
        </div>
        <SeasonMark size="large" label />
      </div>
      <div class="work-facts">
        <div class="work-fact"><span>Version</span><strong>{work.version}</strong></div>
        <div class="work-fact"><span>Status</span><strong>{work.status}</strong></div>
        <div class="work-fact"><span>Platform</span><strong>{work.platform}</strong></div>
        <div class="work-fact"><span>Minecraft</span><strong>{work.minecraft}</strong></div>
        <div class="work-fact"><span>Runtime</span><strong>{work.java}</strong></div>
      </div>
    </div>
  </header>

  <section class="inventory-ribbon" aria-label="LISeasons 核心系统物品栏">
    <div class="shell inventory-ribbon__inner">
      <div class="inventory-slot"><VoxelBlock type="grass" size="medium" /><span>四季节气</span><kbd>1</kbd></div>
      <div class="inventory-slot"><VoxelBlock type="leaf" size="medium" /><span>群系染色</span><kbd>2</kbd></div>
      <div class="inventory-slot"><VoxelBlock type="ice" size="medium" /><span>冬冻春融</span><kbd>3</kbd></div>
      <div class="inventory-slot"><VoxelBlock type="redstone" size="medium" /><span>体感温度</span><kbd>4</kbd></div>
      <div class="inventory-slot"><VoxelBlock type="meteor" size="medium" /><span>流星事件</span><kbd>5</kbd></div>
      <div class="inventory-slot"><VoxelBlock type="book" size="medium" /><span>日历文档</span><kbd>6</kbd></div>
    </div>
  </section>

  <section class="section shell">
    <div class="section-heading">
      <span class="eyebrow">Overview / 它是什么</span>
      <div>
        <h2>一套会进入世界状态的四季系统。</h2>
        <p>LISeasons 把日期、二十四节气、气候和服务器玩法放在同一条时间线上。季节变化不只出现在记分板：群系颜色、冰雪、作物、天气、温度、节日和特殊事件都会参与其中。</p>
      </div>
    </div>

    <div class="feature-chapter">
      <div><span class="feature-chapter__number">01 / TIME</span><h2>让时间有层次</h2></div>
      <div class="feature-chapter__body">
        <p>支持现实同步、游戏天数和自定义推进三种日历模式。四季之上还有二十四节气，服主可以按世界节奏选择日期来源，玩家则通过指令、占位符和六页日历 GUI 理解当前时间。</p>
        <div class="feature-list">
          <div><strong>三种日历模式</strong><span>现实日期、游戏时间或自定义自动推进。</span></div>
          <div><strong>二十四节气</strong><span>比四季更细的时间节点与展示内容。</span></div>
          <div><strong>六页日历 GUI</strong><span>总览、季节、节气、温度、事件与帮助。</span></div>
          <div><strong>PlaceholderAPI</strong><span>把季节信息接入 TAB、聊天与其他界面。</span></div>
        </div>
      </div>
    </div>

    <div class="feature-chapter">
      <div><span class="feature-chapter__number">02 / WORLD</span><h2>让世界真的换季</h2></div>
      <div class="feature-chapter__body">
        <p>季节调色使用 NMS 批量改写区块群系数据，并统一发送区块数据包，替代连续 setBiome 与 refreshChunk。配合冬季结冰、春季融化、作物和天气规则，让不同季节在生存世界里呈现可辨认的状态。</p>
        <div class="feature-list">
          <div><strong>季节群系染色</strong><span>春绿、夏盛、秋暖、冬冷的整体自然色调。</span></div>
          <div><strong>冬冻春融</strong><span>按预算渐进处理玩家附近水面和季节冰。</span></div>
          <div><strong>作物与天气</strong><span>按季节控制生长倍率、降水与世界反馈。</span></div>
          <div><strong>体感温度</strong><span>季节、时段、天气、高度、潮湿和环境共同参与。</span></div>
        </div>
        <div class="notice notice--danger" style="margin-top: 1.5rem;">
          <strong>启用 NMS 染色前必须备份世界</strong>
          <p>当前方案会修改并保存区块群系数据，不是仅客户端显示的临时滤镜。恢复旧世界或切换方案前，请先阅读染色文档中的持久化与回滚说明。</p>
        </div>
      </div>
    </div>

    <div class="feature-chapter">
      <div><span class="feature-chapter__number">03 / EVENTS</span><h2>让季节拥有故事</h2></div>
      <div class="feature-chapter__body">
        <p>16 种季节事件为服务器日常加入可预期又不完全重复的变化。夜间流星雨使用高空轨迹、共同辐射方向与少量随机流星，火流星在高空熄灭后暗飞行，并在落点爆闪和结算可配置奖励。</p>
        <div class="feature-list">
          <div><strong>16 种季节事件</strong><span>按季节与日期组织，效果强度可配置。</span></div>
          <div><strong>真实感流星雨</strong><span>高空生成、连续尾焰、随机方位和暗飞行。</span></div>
          <div><strong>可配置陨石奖励</strong><span>掉落物、概率与落点反馈均可调整。</span></div>
          <div><strong>现实日期节日</strong><span>默认节日、自定义消息和服务器庆祝内容。</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--bordered">
    <div class="shell">
      <div class="section-heading">
        <span class="eyebrow">Environment / 运行环境</span>
        <div><h2>先确认版本，<br />再进入正式世界。</h2><p>LISeasons 包含服务端版本相关的 NMS 模块；安装前应按文档核对核心版本和 ProtocolLib。</p></div>
      </div>
      <div class="directory-grid">
        <div class="directory-card"><span class="directory-card__group">必须前置</span><h2>ProtocolLib</h2><p>缺失时插件不会进入正常运行状态；应安装与服务端匹配的构建。</p></div>
        <div class="directory-card"><span class="directory-card__group">支持核心</span><h2>Paper / Folia</h2><p>面向 1.21.11、26.1.2 与 26.2 的版本配置；NMS 支持以文档矩阵为准。</p></div>
        <div class="directory-card"><span class="directory-card__group">Java</span><h2>Java 21</h2><p>插件字节码和构建配置使用 Java 21。</p></div>
        <div class="directory-card"><span class="directory-card__group">可选联动</span><h2>PAPI · Crops · Dominion</h2><p>显示占位符、自定义作物与领地环境规则按需启用。</p></div>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="cta-band__inner shell">
      <h2>从安装开始，<br />把第一年四季交给世界。</h2>
      <div class="button-row">
        <a class="button button--primary" href={withBase('/docs/liseasons/install/')}>查看安装指南</a>
        <a class="button" href={withBase('/docs/liseasons/configuration/')}>配置参考</a>
      </div>
    </div>
  </section>
</BaseLayout>
