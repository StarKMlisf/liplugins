---
import VoxelBlock from '@/components/VoxelBlock.astro';
import { withBase } from '@/lib/paths';

const hotbar = [
  { type: 'grass', label: '季节' },
  { type: 'gold', label: '经济' },
  { type: 'amethyst', label: '附魔' },
  { type: 'redstone', label: '称号' },
  { type: 'leaf', label: '宠物' },
  { type: 'meteor', label: '末影龙' },
  { type: 'book', label: '文档' },
  { type: 'ice', label: '外观' },
  { type: 'grass', label: '更多' },
] as const;
---

<div class="server-stage" aria-label="牢李插件 Minecraft 服务器运行画面">
  <div class="server-stage__bar">
    <span><i></i> play.laoli.world</span>
    <span>ONLINE · 20 TPS</span>
  </div>

  <div class="server-stage__world">
    <img src={withBase('/season-world.svg')} alt="春夏秋冬组成的原创像素方块世界" />
    <div class="server-stage__shade"></div>
    <div class="server-stage__coords">XYZ 128 / 72 / -36</div>
    <div class="server-stage__season">AUTUMN · DAY 072</div>
    <span class="server-stage__crosshair" aria-hidden="true"></span>

    <div class="server-stage__toast">
      <VoxelBlock type="book" size="small" />
      <span><small>NEW CONTENT</small><strong>11 款插件已载入</strong></span>
    </div>

    <div class="server-stage__hud">
      <div class="server-stage__hearts" aria-label="生命值已满">
        {Array.from({ length: 10 }).map(() => <span>♥</span>)}
      </div>
      <div class="server-stage__hotbar" aria-label="玩法快捷栏">
        {hotbar.map((slot, index) => (
          <span class:list={{ 'is-active': index === 0 }} title={slot.label}>
            <VoxelBlock type={slot.type} size="small" />
            <b>{index + 1}</b>
          </span>
        ))}
      </div>
    </div>
  </div>

  <div class="server-stage__footer">
    <span>BIOME: SEASONAL_FOREST</span>
    <span>PAPER 26.1.2</span>
  </div>
</div>

<style>
  .server-stage {
    position: relative;
    overflow: hidden;
    border: 4px solid #101710;
    border-radius: 4px;
    background: #101710;
    box-shadow: 10px 10px 0 rgba(0, 0, 0, .3), 0 30px 80px rgba(0, 0, 0, .28);
    font-family: "Cascadia Code", Consolas, monospace;
  }

  .server-stage__bar,
  .server-stage__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 40px;
    padding: 0 .85rem;
    color: #d8e5d6;
    background: #18231a;
    font-size: .62rem;
    font-weight: 800;
    letter-spacing: .08em;
  }

  .server-stage__bar span:first-child { display: inline-flex; gap: .55rem; align-items: center; }
  .server-stage__bar i { width: 8px; height: 8px; background: #70dd62; box-shadow: 0 0 0 3px rgba(112, 221, 98, .15); }
  .server-stage__bar span:last-child { color: #8fe986; }

  .server-stage__world {
    position: relative;
    min-height: 500px;
    overflow: hidden;
    border-block: 3px solid #0b100c;
    background: #9fd1e6;
  }

  .server-stage__world > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
    transform: scale(1.025);
  }

  .server-stage__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(6, 13, 9, .13), transparent 30%, transparent 62%, rgba(5, 10, 7, .48)),
      linear-gradient(90deg, rgba(5, 10, 7, .16), transparent 20%, transparent 80%, rgba(5, 10, 7, .16));
    pointer-events: none;
  }

  .server-stage__coords,
  .server-stage__season {
    position: absolute;
    top: 1rem;
    color: white;
    font-size: .59rem;
    font-weight: 900;
    letter-spacing: .07em;
    text-shadow: 2px 2px 0 rgba(0, 0, 0, .7);
  }

  .server-stage__coords { left: 1rem; }
  .server-stage__season { right: 1rem; }

  .server-stage__crosshair {
    position: absolute;
    top: 48%;
    left: 50%;
    width: 19px;
    height: 19px;
    transform: translate(-50%, -50%);
  }

  .server-stage__crosshair::before,
  .server-stage__crosshair::after { position: absolute; background: rgba(255, 255, 255, .9); content: ''; filter: drop-shadow(1px 1px 0 rgba(0, 0, 0, .65)); }
  .server-stage__crosshair::before { top: 8px; left: 0; width: 19px; height: 2px; }
  .server-stage__crosshair::after { top: 0; left: 8px; width: 2px; height: 19px; }

  .server-stage__toast {
    position: absolute;
    top: 3rem;
    right: 1rem;
    display: flex;
    gap: .65rem;
    align-items: center;
    min-width: 190px;
    padding: .65rem .8rem;
    border: 2px solid rgba(255, 255, 255, .72);
    background: rgba(11, 16, 12, .86);
    color: white;
    box-shadow: 4px 4px 0 rgba(0, 0, 0, .32);
  }

  .server-stage__toast span { display: grid; }
  .server-stage__toast small { color: #8fe986; font-size: .5rem; letter-spacing: .12em; }
  .server-stage__toast strong { font-family: var(--font-body); font-size: .72rem; }

  .server-stage__hud { position: absolute; right: 1rem; bottom: .9rem; left: 1rem; }
  .server-stage__hearts { display: flex; gap: 1px; justify-content: center; margin-bottom: .28rem; color: #fb564d; font-size: 1rem; line-height: 1; text-shadow: 2px 2px 0 #761d1d; }

  .server-stage__hotbar {
    display: grid;
    width: min(100%, 430px);
    grid-template-columns: repeat(9, 1fr);
    gap: 2px;
    margin-inline: auto;
    padding: 3px;
    background: rgba(18, 18, 18, .76);
    box-shadow: inset 0 0 0 2px rgba(0, 0, 0, .72);
  }

  .server-stage__hotbar > span {
    position: relative;
    display: grid;
    aspect-ratio: 1;
    place-items: center;
    border: 2px solid rgba(255, 255, 255, .28);
    background: rgba(83, 83, 83, .7);
    box-shadow: inset 2px 2px 0 rgba(255, 255, 255, .16), inset -2px -2px 0 rgba(0, 0, 0, .28);
  }

  .server-stage__hotbar > span.is-active { border-color: white; background: rgba(110, 110, 110, .82); transform: translateY(-2px); }
  .server-stage__hotbar b { position: absolute; right: 2px; bottom: 0; color: white; font-size: .48rem; text-shadow: 1px 1px 0 black; }
  .server-stage__hotbar :global(.voxel-block) { width: 1.45rem; height: 1.45rem; }
  .server-stage__footer { min-height: 34px; color: #819083; background: #111812; font-size: .54rem; }
  .server-stage__footer span:last-child { color: #aebaac; }

  @media (max-width: 620px) {
    .server-stage { border-width: 3px; box-shadow: 6px 6px 0 rgba(0, 0, 0, .28); }
    .server-stage__world { min-height: 355px; }
    .server-stage__bar span:last-child,
    .server-stage__footer span:first-child { display: none; }
    .server-stage__bar,
    .server-stage__footer { justify-content: center; }
    .server-stage__toast { top: 2.65rem; right: .7rem; min-width: 170px; }
    .server-stage__season { display: none; }
    .server-stage__hud { right: .45rem; bottom: .55rem; left: .45rem; }
    .server-stage__hotbar { gap: 1px; padding: 2px; }
    .server-stage__hotbar > span { border-width: 1px; }
    .server-stage__hotbar :global(.voxel-block) { width: 1.05rem; height: 1.05rem; border-width: 1px; }
  }
</style>
