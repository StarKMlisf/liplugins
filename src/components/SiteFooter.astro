---
import SeasonMark from '@/components/SeasonMark.astro';
import { siteMeta } from '@/data/site';
import { withBase } from '@/lib/paths';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell site-footer__grid">
    <div class="site-footer__identity">
      <SeasonMark size="small" />
      <div>
        <strong>{siteMeta.name}</strong>
        <p>{siteMeta.englishName}</p>
      </div>
    </div>
    <div class="site-footer__links">
      <a href={withBase('/works/')}>作品</a>
      <a href={withBase('/about/')}>关于</a>
      <a href={siteMeta.repository} target="_blank" rel="noreferrer">官网 GitHub</a>
    </div>
    <div class="site-footer__meta">
      <span>© {year} 牢李插件系列</span>
      <span>为 Minecraft 服务器认真制作</span>
      <span>感谢XY支持</span>
    </div>
  </div>
</footer>
